# Optional but recommended for real accounts and cross-device sync.
# Create a project at https://supabase.com and copy these from Project Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Existing server endpoint for Gemini responses with Google Search grounding.
# The endpoint must accept the JSON payload documented in README.md and return { "answer": "..." }.
VITE_AI_API_URL=

# For AI coaching, configure a server-side Edge Function.
# Never put a private LLM API key in VITE_* variables or frontend code.
