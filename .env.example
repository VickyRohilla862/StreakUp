# Google OAuth Web Client ID. Create it
 in Google Cloud Console and add this
# site's HTTPS origin to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# Existing server endpoint for Gemini responses with Google Search grounding.
VITE_AI_API_URL=https://your-project.supabase.co/functions/v1/ai-coach

# Optional model defaults.
VITE_GEMINI_MODEL=gemini-3.8-flash
VITE_GROQ_MODEL=llama-3.3-70b-versatile
VITE_OPENROUTER_MODEL=openai/gpt-oss-120b

# Supabase project settings. Use the anon public key, never the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
