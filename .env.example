# Google OAuth Web Client ID. Create it in Google Cloud Console and add this
# site's HTTPS origin to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# Optional Gemini model name. Users enter their own Google AI Studio API key
# in the AI Coach screen; do not put a Gemini API key in this file.
VITE_GEMINI_MODEL=gemini-3.8-flash

# Optional model defaults for the browser-side provider router.
VITE_GROQ_MODEL=llama-3.3-70b-versatile
VITE_OPENROUTER_MODEL=openai/gpt-oss-120b
